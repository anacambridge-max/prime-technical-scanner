# Upstox API access token. NEVER commit the real value — set this in Vercel's
# Environment Variables UI (or your local .env.local, which is gitignored).
# Upstox access tokens expire daily; you'll need a small refresh flow/cron
# (Upstox's OAuth extended-token flow) to keep this valid every trading day.
UPSTOX_ACCESS_TOKEN=

# Optional: override where the day's scan state is persisted (defaults to /tmp).
# SCANNER_STATE_DIR=/tmp
